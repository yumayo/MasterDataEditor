{
  "include": ["src"],
  "compilerOptions": {
    /* JSX */
    "jsx": "react-jsx",

    /* JSON Import */
    "resolveJsonModule": true,
    "esModuleInterop": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  }
}