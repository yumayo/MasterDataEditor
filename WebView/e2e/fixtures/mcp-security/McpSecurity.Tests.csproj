<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <McpAssemblyDirectory Condition="'$(McpAssemblyDirectory)' == ''">$(MSBuildThisFileDirectory)../../../../App.MasterDataEditor/bin/Debug/net10.0-windows</McpAssemblyDirectory>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Compile Include="../../../../App.MasterDataEditor/Mcp/Mcp*.cs" />
    <Compile Include="../../../../App.MasterDataEditor/Mcp/Tools/*.cs" />
    <Reference Include="ModelContextProtocol"><HintPath>$(McpAssemblyDirectory)/ModelContextProtocol.dll</HintPath></Reference>
    <Reference Include="ModelContextProtocol.Core"><HintPath>$(McpAssemblyDirectory)/ModelContextProtocol.Core.dll</HintPath></Reference>
    <Reference Include="ModelContextProtocol.AspNetCore"><HintPath>$(McpAssemblyDirectory)/ModelContextProtocol.AspNetCore.dll</HintPath></Reference>
    <Reference Include="Microsoft.Extensions.AI.Abstractions"><HintPath>$(McpAssemblyDirectory)/Microsoft.Extensions.AI.Abstractions.dll</HintPath></Reference>
  </ItemGroup>
</Project>
